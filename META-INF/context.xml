<?xml version="1.0" encoding="UTF-8"?>
<Context>
    <Resource
        name="jdbc/kyp22"
        auth="Container"
        type="javax.sql.DataSource"
        driverClassName="com.mysql.cj.jdbc.Driver"
        url="jdbc:mysql://localhost:3306/kyp22?useSSL=false&amp;serverTimezone=UTC"
